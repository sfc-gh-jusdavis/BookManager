# BookManager Environment Configuration
# Copy this file to .env: cp .env.example .env

# App Mode
APP_ENV=development
MOCK_DATA=true

# Snowflake (Phase 4 — not needed while using mock data)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# Okta SAML SSO (Phase 4 — not needed while using mock data)
OKTA_METADATA_URL=
OKTA_ENTITY_ID=
OKTA_ACS_URL=http://localhost:8000/auth/saml/callback

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS
CORS_ORIGINS=http://localhost:5173
